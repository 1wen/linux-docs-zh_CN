#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=()
while IFS= read -r -d '' file; do
  staged_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#staged_files[@]} -eq 0 ]; then
  exit 0
fi

bad_files=()
for file in "${staged_files[@]}"; do
  case "$file" in
    .DS_Store|*/.DS_Store|Thumbs.db|*/Thumbs.db|*.swp|*.swo|*~|*.tmp|*.temp|*.bak|*.orig)
      bad_files+=("$file")
      ;;
  esac
done

if [ ${#bad_files[@]} -gt 0 ]; then
  printf 'pre-commit blocked: temporary or editor artifact files are staged:\n' >&2
  printf '  - %s\n' "${bad_files[@]}" >&2
  exit 1
fi

added_lines=$(git diff --cached --unified=0 --no-color -- "${staged_files[@]}" | grep -E '^\+[^+]' || true)

if [ -z "$added_lines" ]; then
  exit 0
fi

if printf '%s\n' "$added_lines" | grep -F "$HOME" >/dev/null; then
  printf 'pre-commit blocked: staged changes include your HOME path (%s).\n' "$HOME" >&2
  exit 1
fi

if printf '%s\n' "$added_lines" | grep -F "$repo_root" >/dev/null; then
  printf 'pre-commit blocked: staged changes include this repository absolute path (%s).\n' "$repo_root" >&2
  exit 1
fi

temp_path_pattern='/private/var/'"folders/|/var/"'folders/'
if printf '%s\n' "$added_lines" | grep -E "$temp_path_pattern" >/dev/null; then
  printf 'pre-commit blocked: staged changes include a macOS temporary path.\n' >&2
  exit 1
fi
